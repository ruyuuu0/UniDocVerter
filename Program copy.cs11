using System.Diagnostics;
using System.Text.Json;
using System.ComponentModel;

Console.WriteLine("UniDocVerter — локальный конвертер");
Console.WriteLine("Поддерживаются изображения, аудио и видео.");
Console.WriteLine();

string input;

if (args.Length > 0)
{
    input = args[0].Trim('"');
}
else
{
    Console.Write("Путь к файлу: ");
    input = Console.ReadLine()?.Trim().Trim('"') ?? "";
}

if (!File.Exists(input))
{
    Console.WriteLine("Файл не найден.");
    Pause();
    return;
}

input = Path.GetFullPath(input);

try
{
    var probe = await ProbeFileAsync(input);

    bool hasVideo = probe.Streams.Any(s => s.Type == "video");
    bool hasAudio = probe.Streams.Any(s => s.Type == "audio");

    if (!hasVideo && !hasAudio)
    {
        Console.WriteLine("Не удалось найти в файле аудио- или видеопоток.");
        Pause();
        return;
    }

    Console.WriteLine($"Файл: {Path.GetFileName(input)}");
    Console.WriteLine($"Найдено: {(hasVideo ? "видео/изображение " : "")}{(hasAudio ? "аудио" : "")}");
    Console.WriteLine();

    var formats = GetAllowedFormats(hasVideo, hasAudio);

    Console.WriteLine("Доступные форматы: " + string.Join(", ", formats));
    Console.Write("Формат результата: ");

    string extension = Console.ReadLine()?.Trim().TrimStart('.').ToLowerInvariant() ?? "";

    if (!formats.Contains(extension))
    {
        Console.WriteLine("Этот формат не подходит для обнаруженных в файле потоков.");
        Pause();
        return;
    }

    string output = Path.Combine(
        Path.GetDirectoryName(input)!,
        $"{Path.GetFileNameWithoutExtension(input)}_converted.{extension}"
    );

    if (File.Exists(output))
    {
        Console.WriteLine($"Файл уже существует: {output}");
        Pause();
        return;
    }

    var startInfo = new ProcessStartInfo
    {
        FileName = "ffmpeg",
        UseShellExecute = false,
        RedirectStandardError = true,
        CreateNoWindow = true
    };

    startInfo.ArgumentList.Add("-n");
    startInfo.ArgumentList.Add("-i");
    startInfo.ArgumentList.Add(input);

if (IsAudioFormat(extension))
{
    startInfo.ArgumentList.Add("-map");
    startInfo.ArgumentList.Add("0:a:0");
    startInfo.ArgumentList.Add("-vn");
}
else if (extension == "gif")
{
    // GIF — только видео/кадры, аудио в него не записываем.
    startInfo.ArgumentList.Add("-map");
    startInfo.ArgumentList.Add("0:v:0");
    startInfo.ArgumentList.Add("-an");
}
else if (IsImageFormat(extension))
{
    startInfo.ArgumentList.Add("-map");
    startInfo.ArgumentList.Add("0:v:0");
    startInfo.ArgumentList.Add("-frames:v");
    startInfo.ArgumentList.Add("1");
    startInfo.ArgumentList.Add("-an");
}
else
{
    startInfo.ArgumentList.Add("-map");
    startInfo.ArgumentList.Add("0:v:0");

    if (hasAudio)
    {
        startInfo.ArgumentList.Add("-map");
        startInfo.ArgumentList.Add("0:a?");
    }
    else
    {
        startInfo.ArgumentList.Add("-an");
    }
}

    startInfo.ArgumentList.Add(output);

    using var process = Process.Start(startInfo);

    if (process is null)
    {
        Console.WriteLine("Не удалось запустить FFmpeg.");
        Pause();
        return;
    }

    string errorOutput = await process.StandardError.ReadToEndAsync();
    await process.WaitForExitAsync();

    if (process.ExitCode == 0 && File.Exists(output))
    {
        Console.WriteLine();
        Console.WriteLine($"Готово: {output}");
    }
    else
    {
        Console.WriteLine();
        Console.WriteLine("Конвертация не удалась:");
        Console.WriteLine(errorOutput);
    }
}
catch (Win32Exception)
{
    Console.WriteLine("Не найден FFprobe или FFmpeg. Убедись, что они установлены и доступны в PATH.");
}
catch (Exception ex)
{
    Console.WriteLine($"Ошибка: {ex.Message}");
}

Pause();

static async Task<ProbeResult> ProbeFileAsync(string input)
{
    var startInfo = new ProcessStartInfo
    {
        FileName = "ffprobe",
        UseShellExecute = false,
        RedirectStandardOutput = true,
        RedirectStandardError = true,
        CreateNoWindow = true
    };

    startInfo.ArgumentList.Add("-v");
    startInfo.ArgumentList.Add("error");
    startInfo.ArgumentList.Add("-show_entries");
    startInfo.ArgumentList.Add("stream=codec_type");
    startInfo.ArgumentList.Add("-of");
    startInfo.ArgumentList.Add("json");
    startInfo.ArgumentList.Add(input);

    using var process = Process.Start(startInfo)
        ?? throw new InvalidOperationException("Не удалось запустить FFprobe.");

    string json = await process.StandardOutput.ReadToEndAsync();
    string error = await process.StandardError.ReadToEndAsync();
    await process.WaitForExitAsync();

    if (process.ExitCode != 0)
        throw new InvalidOperationException(string.IsNullOrWhiteSpace(error)
            ? "FFprobe не смог прочитать файл."
            : error);

    using var document = JsonDocument.Parse(json);

    var streams = document.RootElement
        .GetProperty("streams")
        .EnumerateArray()
        .Select(stream => new ProbeStream(
            stream.TryGetProperty("codec_type", out var type)
                ? type.GetString() ?? ""
                : ""))
        .ToList();

    return new ProbeResult(streams);
}

static string[] GetAllowedFormats(bool hasVideo, bool hasAudio)
{
    var formats = new List<string>();

    if (hasVideo)
    {
        formats.AddRange(new[]
        {
            "png", "jpg", "webp",
            "gif",
            "mp4", "webm", "mkv"
        });
    }

    if (hasAudio)
        formats.AddRange(new[] { "mp3", "wav", "aac", "opus", "m4a" });

    return formats.Distinct().ToArray();
}

static bool IsAudioFormat(string extension) =>
    new[] { "mp3", "wav", "aac", "opus", "m4a" }.Contains(extension);

static bool IsImageFormat(string extension) =>
    new[] { "png", "jpg", "webp" }.Contains(extension);

static void Pause()
{
    Console.WriteLine();
    Console.WriteLine("Нажми Enter, чтобы закрыть окно.");
    Console.ReadLine();
}

record ProbeStream(string Type);
record ProbeResult(List<ProbeStream> Streams);